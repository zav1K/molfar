[resource]
script = ExtResource("1")
display_name = "Матвій"
problem_text = "\"Знайшов оце на подвір'ї... лялечку якусь, вузлик. Боюсь навіть довше в руках тримати — ще й шнурочком перев'язана, ніби навмисне. Забери, будь ласка, не хочу, щоб воно в хаті лежало.\""
true_threat = 0
satisfied_text = "\"Дякую, що забрав це від мене.\""
unhelped_text = "\"То я... і далі маю це тримати?\""
offers_item_id = &"straw_doll"
choice_prompt = "Що питаєш?"
choice_a_label = "Хто міг це лишити?"
choice_a_response = "\"Не знаю... чи ворог якийсь, чи просто діти бавились. Не хочу навіть думати.\""
choice_b_label = "Промовчати."
choice_b_response = "Він лише киває, явно радий, що вже позбувся."
portrait_door = ExtResource("2")
