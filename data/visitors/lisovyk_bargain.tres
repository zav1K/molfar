[gd_resource type="Resource" script_class="Visitor" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/resources/visitor.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/hut/lisovyk.png" id="2"]

[resource]
script = ExtResource("1")
display_name = "Лісовик"
problem_text = "Цієї ночі він не згинається під дашок — просто дивиться у вікно, і вікно нижче за його пояс.\n\n\"Люди ходять по моєму лісі з ломаками й кличуть мене на ім'я. Імені вони не знають, тому кличуть усяке.\" Пауза така довга, що ти встигаєш подумати, що він пішов. \"Я можу відвести їх од стежок. Усіх. Вони блукатимуть до ранку й вернуться додому самі. Скажи слово — і я відведу.\""
true_threat = 2
night_visitor = true
required_flag = &"met_lisovyk"
knocked_sets_flag = &"lisovyk_offered_to_mislead"
satisfied_text = "\"Добре.\" Він відходить од вікна. \"Вони блукатимуть, замерзнуть і злякаються, і скажуть, що то нечисть їх водила. І будуть праві.\" Світає, і в лісі справді цілий день перегукуються."
unhelped_text = "\"Як хочеш.\" Мох сиплеться йому з бороди на підвіконня. \"Ти завжди волів, щоб люди самі. Побачимо, чим це скінчиться для тебе.\""
recurring_group = &"lisovyk"
choice_prompt = "Дозволиш йому?"
choice_a_label = "Хай відведе"
choice_a_response = "Ти киваєш. Він зникає без звуку, і цілу ніч із лісу чути, як хтось кличе когось і не знаходить."
choice_a_path_shift = -1
choice_b_label = "Хай ідуть"
choice_b_response = "Ти кажеш, щоб не чіпав. \"Отже, ти досі з ними.\" Він каже це без докору, скоріше з подивом."
choice_b_path_shift = 1
portrait_door = ExtResource("2")
waiting_portrait_content_rect = Rect2(0.211063, 0.036133, 0.529840, 0.902344)
