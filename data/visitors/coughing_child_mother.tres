script = ExtResource("1")
display_name = "Молода жінка"
problem_text = "\"Дитина кашляє вже третю ніч, а мольфар-сусід каже — то не застуда. Я вже й компреси робила, і молоко з медом давала — нічого не йме. Вночі найгірше, аж самій не по собі стає, дивитись на це.\""
