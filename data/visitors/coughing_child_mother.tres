desired_result_id = &"cold_remedy"
satisfied_text = "\"Дякую, мольфаре. Кашель ущух ще тої ж ночі. Вперше за три дні спала спокійно й сама.\""
unhelped_text = "\"Це не помогло... дитині й не легше. Піду, пошукаю іншого способу.\""
