[resource]
script = ExtResource("1")
display_name = "Вдова"
problem_text = "\"Кажуть, це я наврочила Гальчину корову... Не знаю вже, до кого йти, крім тебе...\""
true_threat = 0
satisfied_text = "Дякую, що вислухав. Хоч трохи легше на душі."
