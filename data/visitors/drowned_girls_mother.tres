[gd_resource type="Resource" script_class="Visitor" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/visitor.gd" id="1"]

[resource]
script = ExtResource("1")
display_name = "Мати втопленої"
problem_text = "\"Моїй Ганнусі минулого літа було сімнадцять.\" Вона тримає в руках дівочу хустку, складену вчетверо. \"Її витягли з-під греблі на третій день. Священник не дав її ховати з людьми, бо каже — сама пішла у воду. Вона не сама, мольфаре, я її знала.\" Вона дивиться на тебе. \"Я не прошу нічого неправильного. Я прошу, щоб вона перестала мені снитися щоночі, бо я вже не знаю, живу я чи ні.\""
true_threat = 0
desired_result_id = &"sleep_remedy"
alt_desired_result_id = &"calming_remedy"
satisfied_text = "Вона бере пляшечку й усе одно не йде.\n\n\"А як вона вам колись прийде — не гоніть. Вона дитина ще. Вона й за життя боялася темного.\" Тільки тоді вона обертається до дверей."
unhelped_text = "\"Я так і думала, що на це нема нічого.\" Вона складає хустку ще раз, навпіл, і забирає з собою."
knocked_sets_flag = &"met_drowned_girls_mother"
satisfied_sets_flag = &"promised_drowned_girls_mother"
payment_type = 3
payment_flag_id = &"drowned_girl_was_refused_burial"
payment_flavor_text = "Ти знаєш тепер, кого саме не дали поховати при церкві й чому"
