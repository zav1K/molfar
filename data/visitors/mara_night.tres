[gd_resource type="Resource" script_class="Visitor" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/visitor.gd" id="1"]

[resource]
script = ExtResource("1")
display_name = "Мара"
problem_text = "Спершу тобі здається, що за дверима нікого. Потім ти бачиш її — вона стоїть саме там, куди ти не дивився.\n\n\"Я до тебе щоночі ходжу, Онуфрію, тільки ти мене зранку не пам'ятаєш.\" Вона говорить дуже тихо, і ти чомусь чуєш її чітко. \"Цієї ночі я вирішила постукати. Чемніше ж.\""
true_threat = 2
night_visitor = true
satisfied_text = "Вона не заходить — вона просто виявляється всередині, коли ти обертаєшся.\n\nДо ранку тобі сниться, що ти стоїш у себе на подвір'ї й дивишся, як у вікні горить світло. Прокидаєшся з відчуттям, що не доспав тижня."
unhelped_text = "\"Як хочеш.\" Вона не йде нікуди, вона просто перестає бути там, де була. \"Усе одно побачимось, як заснеш.\""
knocked_sets_flag = &"met_mara"
recurring_group = &"mara"
