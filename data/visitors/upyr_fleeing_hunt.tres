[ext_resource type="Texture2D" path="res://assets/hut/upyr_hidden_female_1.png" id="2"]

[resource]
script = ExtResource("1")
display_name = "Причаєна упириця"
problem_text = "Вона не просить увійти. Вона стоїть збоку від дверей, притиснувшись до стіни, щоб не бути видною зі стежки.\n\n\"Виходить, я добре навчилася. Мене вже двічі минули.\" Говорить швидко й тихо. \"Там унизу з факелами, вони вже в трьох хатах були. Я прийшла не ховатися — я прийшла сказати.\"\n\nВона озирається вниз.\n\n\"Вони питають не про нечисть, мольфаре. Вони питають, хто з людей її переховує. Різниця невелика, та вона є, і вона тепер твоя.\""
true_threat = 2
night_visitor = true
required_flag = &"helped_hidden_upyr"
knocked_sets_flag = &"warned_by_hidden_upyr"
desired_result_id = &"strong_ward_remedy"
alt_desired_result_id = &"anti_curse_remedy"
satisfied_text = "Вона бере й не дякує — у неї нема на це часу.\n\n\"Як прийдуть до тебе — не відчиняй одразу. Хто одразу відчиняє, той, кажуть, чекав.\" І вона зникає від стіни, не відходячи від неї."
unhelped_text = "\"Правильно.\" Вона вже не дивиться на тебе, вона дивиться вниз, на вогні. \"Ти хоч трохи поживеш.\""
satisfied_sets_flag = &"helped_fleeing_upyr"
satisfied_path_shift = 1
portrait_door = ExtResource("2")
waiting_portrait_content_rect = Rect2(0.231332, 0.060547, 0.578331, 0.865234)
