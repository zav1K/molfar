[gd_resource type="Resource" script_class="Visitor" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/visitor.gd" id="1"]

[resource]
script = ExtResource("1")
display_name = "Баба-шептуха"
problem_text = "\"У мене полин вийшов увесь, а купальського збору цього року не встигла — лежала хвора. Позич, Онуфрію. Віддам восени сушеним цвітом, його я більше за тебе маю.\" Вона вже простягає порожнє полотняне вузлище."
true_threat = 0
desired_result_id = &"cleansing_remedy"
satisfied_text = "\"От і добре. Двоє старих на одні гори — чого б нам не ділитися.\" Вона загортає відвар дбайливо, як чуже дитя."
unhelped_text = "\"Нема — то й нема. Обійдуся лободою, хоч вона й слабша.\" Вона зав'язує порожнє вузлище й кладе за пазуху."
payment_type = 1
payment_item_id = &"mat_goods"
payment_amount = 2
payment_flavor_text = "Сушений цвіт, віск, клубок суканої нитки"
recurring_group = &"whisperer_woman"
