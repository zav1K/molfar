[resource]
script = ExtResource("1")
display_name = "Священник"
problem_text = "\"Не допомагай тим, кого бачив коло хати ночами, мольфаре. Нечисть забрала Лісника — і тих, хто її переховує, тримає на совісті те саме. Начувайся й ти.\""
satisfied_text = "Він чекає відповіді, не сідаючи."
unhelped_text = "Він іде, не чекаючи відповіді."
knocked_sets_flag = &"priest_forbade_nechyst"
choice_prompt = "Повіриш йому?"
choice_a_label = "Повірити"
choice_a_response = "Ти киваєш, не питаючи зайвого... Він ніби й сам полегшено зітхає, хоч і намагається цього не показати."
choice_a_path_shift = 1
choice_b_label = "Засумніватись"
choice_b_response = "Чому він не просить захисту для себе, а одразу велить, кого цуратись? Ти не кажеш цього вголос — лише дивишся довше, ніж годиться."
choice_b_path_shift = -1

portrait_door = ExtResource("2")
waiting_portrait_content_rect = Rect2(0.236070, 0.073242, 0.514663, 0.862305)
required_flag = &"__chapter1_scripted_only__"
