[resource]
script = ExtResource("1")
display_name = "Сільський староста"
problem_text = "\"Люди налякані, мольфаре. Після Лісника вже й самі хочуть діяти — хтось каже обходити хати, шукати, хто не такий, як усі. Я... я не знаю, чи правильно це, але зупинити їх уже не можу.\""
true_threat = 0
satisfied_text = "Він киває, не чекаючи відповіді, і йде — ніби сам не вірить у те, що щойно сказав."
unhelped_text = "Він киває, не чекаючи відповіді, і йде — ніби сам не вірить у те, що щойно сказав."
portrait_door = ExtResource("2")
waiting_portrait_content_rect = Rect2(0.206745, 0.043945, 0.593842, 0.885742)
required_flag = &"lisnyk_found_dead"
knocked_sets_flag = &"elder_hunt_warning"
choice_prompt = "Що скажеш?"
choice_a_label = "Стримай їх, поки не пізно."
choice_a_response = "\"Спробую. Хоч не знаю вже, чи мене послухають.\""
choice_a_path_shift = 1
choice_b_label = "Може, так і треба."
choice_b_response = "Він довго мовчить, тоді киває й іде, не кажучи більше нічого."
choice_b_path_shift = -1
recurring_group = &"hail_elder"
