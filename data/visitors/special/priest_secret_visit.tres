[gd_resource type="Resource" script_class="Visitor" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/visitor.gd" id="1"]

[resource]
script = ExtResource("1")
display_name = "Незнайомець у рясі"
problem_text = "\"Прийшов не як священник... як батько. Донька моя хвора, а лікар тутешній вже безсилий...\""
true_threat = 0
satisfied_text = "Хай Бог тебе... хай тобі віддячиться, мольфаре. Про цей візит ніхто не дізнається."
unhelped_text = "Я сподівався... Що ж, піду, поки мене тут не бачили."
