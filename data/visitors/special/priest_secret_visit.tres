[ext_resource type="Texture2D" path="res://assets/hut/priest_secret_visit.png" id="2"]

[resource]
script = ExtResource("1")
display_name = "Незнайомець у рясі"
problem_text = "\"Прийшов не як священник... як батько. Донька моя хвора, а лікар тутешній вже безсилий...\""
true_threat = 0
desired_result_id = &"strengthening_remedy"
satisfied_text = "Хай Бог тебе... хай тобі віддячиться, мольфаре. Про цей візит ніхто не дізнається. ...Зачекай. Раз я вже тут, а сповідатись мені, вважай, нема кому. Ту дівчину, що навесні втопилась — я не відспівав її як належить. Родина просила, а я побоявся: церква на таку смерть дивиться так, як дивиться, ти й сам знаєш. Тепер думаю — а що, як то було не гріхом, а нещастям, і я підвів усіх. І її, і живих. Не знаю вже, кому з нас двох важче — тобі з твоїм даром, чи мені з моїм саном."
unhelped_text = "Я сподівався... Що ж, піду, поки мене тут не бачили."
payment_type = 1
payment_item_id = &"mat_goods"
payment_flavor_text = "Свічки, дещо з церковного майна — або, може, просто мовчання замість цього"
night_visitor = true
required_flag = &"mara_first_visit"
knocked_sets_flag = &"priest_confession_heard"
portrait_door = ExtResource("2")
waiting_portrait_content_rect = Rect2(0.234375, 0.071615, 0.509766, 0.861979)
