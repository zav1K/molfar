[resource]
script = ExtResource("1")
display_name = "Лісник"
problem_text = "\"Вночі не сплю навіть із твоїм зіллям. Весь час здається, ніби хтось стоїть за деревом і чекає, щоб я пішов звідти. Дурне, знаю. Дай ще зілля, як є.\""
