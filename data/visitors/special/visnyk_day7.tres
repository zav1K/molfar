[resource]
script = ExtResource("1")
display_name = "Вісник"
problem_text = "\"Мольфаре... Миколу знайшли вранці, під старим дубом при дорозі до церкви. Не дійшов... Староста каже — то нечисть, кого ж іще. Люди вже й смолоскипи готують, хочуть вигін обходити зі свяченою водою.\""
satisfied_text = "Він хреститься й іде далі, нести звістку сусідам."
unhelped_text = "Він хреститься й іде далі, нести звістку сусідам."
knocked_sets_flag = &"lisnyk_found_dead"

required_flag = &"__chapter1_scripted_only__"
