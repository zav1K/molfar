[resource]
script = ExtResource("1")
display_name = "Прокіп, староста"
problem_text = "\"Чорні чутки по селу, мольфаре. Кажуть, щось чіпляється до людей ночами. Люди лякаються, хочуть вартувати коло церкви. Виріж хоч кривульку на одвірок громаді — щоб лихе не переступило поріг, раз уже такий переступає будь-де.\""
true_threat = 0
desired_result_id = &"zigzag_ward"
satisfied_text = "\"Громада не забуде цього, мольфаре.\""
unhelped_text = "\"Що ж... якщо не можеш — не можеш. Хай буде, як буде.\""
