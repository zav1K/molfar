[gd_resource type="Resource" script_class="Visitor" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/visitor.gd" id="1"]

[resource]
script = ExtResource("1")
display_name = "Лісовик"
problem_text = "Він не стукав — просто стало темніше, і ти вийшов подивитися чому. Він стоїть, зігнувшись, щоб умістити голову під дашком, і з його бороди на землю сиплеться сухий мох.\n\n\"Ти носив мені хліб на пень тридцять років.\" Голос такий, наче дерево тре об дерево. \"Цієї весни не носив. Я прийшов спитати, чи ти помер, чи забув. Виходить, ні те, ні те.\"\n\nВін чекає, і видно, що чекати він може до ранку й довше."
true_threat = 2
night_visitor = true
offers_item_id = &"mat_wood"
satisfied_text = "Він кладе на поріг сухий покручений корінь — такого дерева ти не знаєш.\n\n\"Тепер квитні. І хліба більше не носи: тобі самому мало лишилося, я чую.\" Він розгинається, і крокв під дашком тріщить. До ранку на подвір'ї ні сліду, тільки насипано моху там, де він стояв."
unhelped_text = "\"Ну то й нічого.\" Він стоїть ще довго, потім відступає в темряву, не повертаючись. \"Я почекаю. Я вмію довше за тебе.\""
recurring_group = &"lisovyk"
knocked_sets_flag = &"met_lisovyk"
satisfied_sets_flag = &"squared_with_lisovyk"
