[resource]
script = ExtResource("1")
id = &"straw_doll"
display_name = "Солом'яна лялька"
description = "Вузлик, знайдений на чужому подвір'ї — хтось наклав його навмисне. Лежить у скрині, доки не вирішиш, що з ним робити."
