; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Молфар"
config/description="2D crafting-simulator про мольфара-спадкоємця в Карпатах, 17 століття."
run/main_scene="res://scenes/Hut.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[autoload]

IngredientDatabase="*res://scripts/autoload/ingredient_database.gd"
GameCalendar="*res://scripts/autoload/game_calendar.gd"
PlayerInventory="*res://scripts/autoload/player_inventory.gd"
WardRack="*res://scripts/autoload/ward_rack.gd"
PotionDatabase="*res://scripts/autoload/potion_database.gd"
RecipeDatabase="*res://scripts/autoload/recipe_database.gd"
SigilDatabase="*res://scripts/autoload/sigil_database.gd"
VisitorDatabase="*res://scripts/autoload/visitor_database.gd"
CarvedSigilRegistry="*res://scripts/autoload/carved_sigil_registry.gd"
GardenState="*res://scripts/autoload/garden_state.gd"
KeepsakeDatabase="*res://scripts/autoload/keepsake_database.gd"
StoryFlags="*res://scripts/autoload/story_flags.gd"
PathBalance="*res://scripts/autoload/path_balance.gd"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
